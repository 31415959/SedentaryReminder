<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#146B4D33" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#1F6B4D33" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape>
            <solid android:color="#2E6B4D33" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="6dp">
        <shape>
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@color/card_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>